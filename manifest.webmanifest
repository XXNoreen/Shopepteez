{
  "name": "Shopepteez",
  "short_name": "Shopepteez",
  "description": "Inventory, kits, orders, expenses and profit for your peptide shop.",
  "id": "./",
  "start_url": "./?source=pwa",
  "scope": "./",
  "display": "standalone",
  "display_override": [
    "window-controls-overlay",
    "standalone"
  ],
  "orientation": "any",
  "background_color": "#FFF8FB",
  "theme_color": "#E5468A",
  "categories": [
    "business",
    "productivity",
    "finance"
  ],
  "icons": [
    {
      "src": "shopepteez-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "shopepteez-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "shopepteez-maskable.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "shopepteez-icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    }
  ],
  "shortcuts": [
    {
      "name": "New Sale",
      "url": "./?action=newSale",
      "icons": [
        {
          "src": "shopepteez-192.png",
          "sizes": "192x192"
        }
      ]
    },
    {
      "name": "Inventory",
      "url": "./?view=inventory",
      "icons": [
        {
          "src": "shopepteez-192.png",
          "sizes": "192x192"
        }
      ]
    }
  ]
}